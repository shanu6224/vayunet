# Google Earth Engine Configuration
# Specify your Google Cloud Project ID with Earth Engine API enabled
GEE_PROJECT_ID=
# Optional Service Account Key path (if not using `earthengine authenticate`)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Earth Engine Sentinel-5P Satellite Collections (NRTI with OFFL fallback)
GEE_NO2_COLLECTION=COPERNICUS/S5P/NRTI/L3_NO2
GEE_SO2_COLLECTION=COPERNICUS/S5P/NRTI/L3_SO2
GEE_LOOKBACK_DAYS=7

# Set to true for offline demo/testing without GEE credentials
# Once GEE credentials are configured, keep false for REAL satellite data
VAYUNET_DEMO_MODE=false

# Weather Provider (Open-Meteo does not require an API key)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Optional: Gemini AI Explainability Layer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

